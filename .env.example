# Local app
PORT=3031
APP_URL=http://localhost:3031
DB_PATH=./data/local-seo.sqlite
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional free/self-hosted SERP providers for rank checks and SERP analysis.
OPENSERP_URL=
SEARXNG_URL=

# Optional external SEO metrics/index adapter. Not needed for local mode.
SEO_METRICS_API_KEY=

# Optional Google Search Console OAuth. Keep secrets in .env; Settings only shows status.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional local MCP guard. If set, MCP clients must send Authorization: Bearer ...
MCP_TOKEN=

# Local Codex AI jobs
CODEX_MODEL=gpt-5.5
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_MS=600000
